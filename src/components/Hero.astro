              id="shuffleHint"
              class="absolute bottom-3.5 right-3.5 z-10 text-[0.7rem] font-semibold tracking-wide text-white bg-[#2c2422]/75 backdrop-blur-md border border-white/20 px-3 py-1 rounded-full pointer-events-none opacity-85 transition-all duration-300 group-hover:opacity-100 group-hover:bg-accent/90 group-hover:-translate-y-0.5"
