            rel="noopener"
            class="inline-flex items-center px-6 py-2.5 rounded-lg text-sm font-semibold bg-transparent text-brown-dark border-[1.5px] border-[#d5cbc3] dark:border-[#423734] hover:bg-brown-dark hover:border-brown-dark hover:text-white dark:hover:bg-accent-soft dark:hover:border-accent dark:hover:text-brown-dark transition-all duration-300 hover:-translate-y-0.5"
