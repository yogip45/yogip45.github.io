<script is:inline src="https://unpkg.com/typed.js@2.0.16/dist/typed.umd.js"></script>
<script is:inline>
  if (document.getElementById("typed") && window.Typed) {
    new Typed("#typed", {
      strings: [
        "Web Developer",
        "System Implementer",
        "Certified Network Associate",
        "Cybersecurity Enthusiast",
        "Personal Audio Enthusiast",
      ],
      typeSpeed: 48,
      backSpeed: 28,
      backDelay: 2200,
      loop: true,
      cursorChar: "_",
    });
  }
</script>

<script>
  const container = document.getElementById("heroImgContainer");
  const frame = document.getElementById("heroImgFrame");
  const shuffleHint = document.getElementById("shuffleHint");
  let isShuffling = false;

  // Squad 404 Easter Egg State (4 clicks -> pause -> 5 clicks)
  let clickCount = 0;
  let phase = 1;
  let pauseTimer: ReturnType<typeof setTimeout> | null = null;
  let resetTimer: ReturnType<typeof setTimeout> | null = null;

  const squad404Quotes = [
    {
      text: '"Those who don\'t exist have no need for names. Just get the job done."',
      sender: "— UMP45 // SQUAD 404",
    },
    {
      text: '"We are the shadows that survive where others fall. Keep moving forward, Commander."',
      sender: "— UMP45 // SECTOR 09",
    },
    {
      text: '"Kazoku? Yeah, 404 is all the family I need. Now, what\'s our next target?"',
      sender: "— UMP45 // ENCRYPTED CHANNEL",
    },
  ];

  function triggerSquad404EasterEgg() {
    const pick = squad404Quotes[Math.floor(Math.random() * squad404Quotes.length)];
    const quoteEl = document.getElementById("squad404Quote");
    const senderEl = document.getElementById("squad404Sender");
    if (quoteEl) quoteEl.textContent = pick.text;
    if (senderEl) senderEl.textContent = pick.sender;
    document.getElementById("squad404Modal")?.classList.add("is-shown");
  }

  function reset45Sequence() {
    clickCount = 0;
    phase = 1;
    if (pauseTimer) clearTimeout(pauseTimer);
    if (resetTimer) clearTimeout(resetTimer);
    if (frame) {
      frame.style.borderColor = "";
      frame.style.opacity = "";
      frame.style.boxShadow = "";
    }
  }

  function register45Pattern() {
    if (pauseTimer) clearTimeout(pauseTimer);
    if (resetTimer) clearTimeout(resetTimer);
    clickCount++;

    if (phase === 1) {
      if (clickCount === 4) {
        pauseTimer = setTimeout(() => {
          phase = 2;
          clickCount = 0;
          if (frame) {
            frame.style.borderColor = "var(--eye-amber)";
            frame.style.opacity = "0.95";
            frame.style.boxShadow = "0 0 18px rgba(212, 118, 51, 0.35)";
          }
          resetTimer = setTimeout(reset45Sequence, 4500);
        }, 900);
      } else if (clickCount > 4) {
        clickCount = 1;
      }

      if (clickCount < 4) {
        resetTimer = setTimeout(reset45Sequence, 1200);
      }
    } else if (phase === 2) {
      if (clickCount === 5) {
        reset45Sequence();
        triggerSquad404EasterEgg();
        return;
      }
      resetTimer = setTimeout(reset45Sequence, 1200);
    }
  }

  function triggerShuffle() {
    if (!container || isShuffling) return;
    isShuffling = true;
    shuffleHint?.classList.add("opacity-0", "translate-y-1.5");

    const isSwapped = container.classList.contains("is-swapped");
    const origImg = container.querySelector(".hero-img-original");
    const hoverImg = container.querySelector(".hero-img-hover");
    const frontImg = isSwapped ? hoverImg : origImg;
    const backImg = isSwapped ? origImg : hoverImg;

    frontImg?.classList.remove("card-front", "card-back");
    backImg?.classList.remove("card-front", "card-back");

    frontImg?.classList.add("card-front");
    backImg?.classList.add("card-back");
    container.classList.add("shuffling");

    setTimeout(() => {
      isShuffling = false;
    }, 120);

    setTimeout(() => {
      container.classList.toggle("is-swapped");
      container.classList.remove("shuffling");
      frontImg?.classList.remove("card-front");
      backImg?.classList.remove("card-back");
    }, 520);
  }

  container?.addEventListener("click", () => {
    register45Pattern();
    triggerShuffle();
  });
</script>