  <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-7 reveal-up">
