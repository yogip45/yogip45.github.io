            class="absolute inset-[14px_-14px_-14px_14px] border-2 border-accent rounded-tl-[64px] rounded-br-[64px] opacity-35 z-0 transition-all duration-400 group-hover:translate-x-1 group-hover:translate-y-1 group-hover:opacity-65"
