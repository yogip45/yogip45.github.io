---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Yog's Web Portfolio",
  description = "Web Developer specializing in multi-user Hospital Management Systems (SIMRS), REST API integrations, database optimization, and security-conscious web engineering.",
  canonical = "https://yogip45.github.io/",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/new-pp.jpg" />

    <!-- Fonts & Icons -->
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Noto+Sans+JP:wght@100;400;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link href="/assets/font-awesome/css/all.min.css" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />

    <!-- Primary Meta Tags -->
    <meta
      name="title"
      content="Narindra Yogi Pradana — Web Developer & System Implementer"
    />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Narindra Yogi Pradana, Yog, Web Developer, SIMRS, CodeIgniter, PHP, PostgreSQL, Networking, Cybersecurity, Portfolio"
    />
    <meta name="author" content="Narindra Yogi Pradana" />
    <meta name="theme-color" content="#87685d" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Yog's Web Portfolio" />
    <meta
      property="og:title"
      content="Narindra Yogi Pradana — Web Developer & System Implementer"
    />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://yogip45.github.io/assets/img/new-pp.jpg"
    />
    <meta property="og:image:alt" content="Narindra Yogi Pradana Portfolio" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonical} />
    <meta
      name="twitter:title"
      content="Narindra Yogi Pradana — Web Developer & System Implementer"
    />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://yogip45.github.io/assets/img/new-pp.jpg"
    />

    <!-- Prevent Theme Flash Before First Paint -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("yog-portfolio-theme");
        const hour = new Date().getHours();
        const isNight = hour >= 18 || hour < 6;
        if ((saved || (isNight ? "dark" : "light")) === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <ClientRouter />
  </head>

  <body>
    <!-- Minimalist Floating Controls (Bottom Right) -->
    <div class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex flex-col items-center gap-2.5">
      <button
        type="button"
        id="backToTopBtn"
        aria-label="Scroll to top"
        title="Back to Top"
        class="w-10 h-10 sm:w-[42px] sm:h-[42px] rounded-xl bg-bg-card text-brown-dark border border-border-warm inline-flex items-center justify-center text-sm cursor-pointer shadow-lg opacity-0 invisible translate-y-2.5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent hover:text-amber-eye"
      >
        <i class="fa-solid fa-arrow-up"></i>
      </button>

      <button
        type="button"
        id="themeToggle"
        aria-label="Toggle dark mode"
        title="Switch Theme"
        class="w-10 h-10 sm:w-[42px] sm:h-[42px] rounded-xl bg-bg-card text-brown-dark border border-border-warm inline-flex items-center justify-center text-sm cursor-pointer shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:border-accent hover:text-amber-eye"
      >
        <i class="fa-solid fa-moon" id="themeIcon"></i>
      </button>
    </div>
    <CommandPalette />
    <slot />

    <!-- Squad 404 Tactical Modal Easter Egg -->
    <div
      class="squad404-overlay fixed inset-0 w-screen h-screen z-[1090] bg-[#120e0d]/70 backdrop-blur-md flex items-center justify-center p-6"
      id="squad404Modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="squad404Title"
    >
      <div class="squad404-dialog relative w-full max-w-[460px] bg-[#1e1917] text-[#f2ece9] border border-[#a68579]/35 rounded-md p-6 shadow-2xl">
        <!-- 4 Corner Tactical Brackets -->
        <span class="pointer-events-none absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-amber-eye"></span>
        <span class="pointer-events-none absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-amber-eye"></span>
        <span class="pointer-events-none absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-amber-eye"></span>
        <span class="pointer-events-none absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-amber-eye"></span>

        <div class="flex justify-between items-center pb-3 mb-4 border-b border-[#a68579]/20">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-eye shadow-[0_0_0_3px_rgba(212,118,51,0.25)]"></span>
            <span
              class="font-mono text-xs font-bold tracking-wider text-amber-eye"
              id="squad404Title"
            >
              ENCRYPTED COMMS // SQUAD 404
            </span>
          </div>
          <span class="font-mono text-[0.68rem] text-[#9e8f8a]">
            FREQ 40.4 MHz
          </span>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-16 h-16 rounded-lg overflow-hidden shrink-0 border border-accent bg-[#2c2422]">
            <img
              src="/assets/img/ump-og.jpeg"
              alt="UMP45"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="flex-1">
            <p
              class="text-[0.92rem] leading-relaxed text-[#f2ece9] italic mb-2"
              id="squad404Quote"
            >
              "Those who don't exist have no need for names. Just get the job
              done."
            </p>
            <div class="flex justify-between items-center">
              <span
                class="font-mono text-xs font-bold text-[#cbbeb9]"
                id="squad404Sender"
              >
                — UMP45 // SQUAD 404
              </span>
              <span class="font-mono text-[0.65rem] text-[#6fd1a6] bg-[#6fd1a6]/10 px-2 py-0.5 rounded">
                DECRYPTED
              </span>
            </div>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-dashed border-[#a68579]/20 text-right">
          <button
            type="button"
            id="close404Modal"
            class="font-mono text-xs font-bold tracking-wider text-amber-eye bg-amber-eye/10 border border-amber-eye rounded px-3.5 py-1.5 cursor-pointer transition-colors hover:bg-amber-eye hover:text-[#181413]"
          >
            [ ACKNOWLEDGE ]
          </button>
        </div>
      </div>
    </div>

    <script>
      // 1. Dark / Light Mode Toggle
      const htmlEl = document.documentElement;
      const themeToggle = document.getElementById("themeToggle");
      const themeIcon = document.getElementById("themeIcon");

      function syncThemeIcon() {
        const isDark = htmlEl.getAttribute("data-theme") === "dark";
        if (themeIcon) {
          themeIcon.classList.toggle("fa-sun", isDark);
          themeIcon.classList.toggle("fa-moon", !isDark);
        }
      }
      syncThemeIcon();

      themeToggle?.addEventListener("click", () => {
        const isDark = htmlEl.getAttribute("data-theme") === "dark";
        const nextTheme = isDark ? "light" : "dark";
        if (nextTheme === "dark") {
          htmlEl.setAttribute("data-theme", "dark");
        } else {
          htmlEl.removeAttribute("data-theme");
        }
        localStorage.setItem("yog-portfolio-theme", nextTheme);
        syncThemeIcon();
      });

      // 2. Back to Top Button
      const backToTopBtn = document.getElementById("backToTopBtn");
      window.addEventListener("scroll", () => {
        if (!backToTopBtn) return;
        if (window.scrollY > 320) {
          backToTopBtn.classList.remove(
            "opacity-0",
            "invisible",
            "translate-y-2.5",
          );
          backToTopBtn.classList.add("opacity-100", "visible", "translate-y-0");
        } else {
          backToTopBtn.classList.add(
            "opacity-0",
            "invisible",
            "translate-y-2.5",
          );
          backToTopBtn.classList.remove(
            "opacity-100",
            "visible",
            "translate-y-0",
          );
        }
      });

      backToTopBtn?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      // 3. Scroll Reveal IntersectionObserver
      const revealEls = document.querySelectorAll(".reveal-up");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const delay = Number(
                  entry.target.getAttribute("data-delay") || 0,
                );
                setTimeout(
                  () => entry.target.classList.add("is-visible"),
                  delay,
                );
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        revealEls.forEach((el) => observer.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      }

      // 4. Squad 404 Modal Close Listeners
      const modal = document.getElementById("squad404Modal");
      const closeModal = () => modal?.classList.remove("is-shown");

      document
        .getElementById("close404Modal")
        ?.addEventListener("click", closeModal);
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal?.classList.contains("is-shown")) {
          closeModal();
        }
      });

      // 5. Smooth Page Transition antar halaman Astro
      document.querySelectorAll('a[href^="/"]').forEach((link) => {
        link.addEventListener("click", (e) => {
          const anchor = link as HTMLAnchorElement;
          const href = anchor.getAttribute("href");
          if (
            !href ||
            href.startsWith("/#") ||
            anchor.target === "_blank" ||
            (e as MouseEvent).ctrlKey ||
            (e as MouseEvent).metaKey
          ) {
            return;
          }
          e.preventDefault();
          document.body.classList.add("page-leaving");
          setTimeout(() => {
            window.location.href = href;
          }, 260);
        });
      });

      window.addEventListener("pageshow", (e) => {
        if (e.persisted) document.body.classList.remove("page-leaving");
      });
    </script>
  </body>
</html>
